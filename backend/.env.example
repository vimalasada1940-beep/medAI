# MediPulse Backend Configuration Example
# Copy this file to .env and replace with your local PostgreSQL credentials

APP_NAME=MediPulse
ENVIRONMENT=development
DEBUG=True
PORT=8000

# PostgreSQL Database Configuration
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=medipulse_db
DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password@localhost:5432/medipulse_db

# Risk Threshold Configuration (in days)
HIGH_RISK_THRESHOLD_DAYS=3
MEDIUM_RISK_THRESHOLD_DAYS=7

# Default Target Stock Coverage for Emergency Indents (in days)
DEFAULT_TARGET_COVERAGE_DAYS=30
